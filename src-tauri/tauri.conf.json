{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Interstitial Diary",
  "version": "0.1.0",
  "identifier": "io.github.jesseracine.interstitialdiary",
  "build": {
    "frontendDist": "../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Interstitial Diary",
        "width": 1100,
        "height": 800,
        "minWidth": 360,
        "minHeight": 480,
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
